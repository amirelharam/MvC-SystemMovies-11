@using MvC_SystemMovies.Models
@model List<ShippingCompany>
@{
    ViewData["Title"] = "Shipping companies";
}

<div class="container">
    <div class="row mb-3 align-items-center my-3">
        <div class="col-md-6"><h2 class="display-6">Shipping companies</h2></div>
        <div class="col-md-6 text-md-end"><a asp-action="Create" class="btn btn-success">Create</a></div>
    </div>

    <table class="table table-hover">
        <thead>
            <tr><th>Name</th><th>Price</th><th>Estimated days</th><th>Active</th><th>Actions</th></tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Name</td>
                    <td>@item.Price.ToString("C")</td>
                    <td>@item.EstimatedDays</td>
                    <td>@(item.IsActive ? "Yes" : "No")</td>
                    <td class="d-flex gap-2">
                        <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@item.Id">Edit</a>
                        <form method="post" asp-action="Delete" asp-route-id="@item.Id">
                            <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
