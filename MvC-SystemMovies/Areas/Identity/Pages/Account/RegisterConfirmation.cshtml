@page
@model MvC_SystemMovies.Areas.Identity.Pages.Account.RegisterConfirmationModel
@{
    ViewData["Title"] = "Register confirmation";
}

<h1>@ViewData["Title"]</h1>
<p>
    A confirmation email has been sent to <strong>@Model.Email</strong>.
    Please check your inbox (and spam folder) and click the link to activate your account before logging in.
</p>
<p><a asp-page="./Login">Back to log in</a></p>
