@page
@model MvC_SystemMovies.Areas.Identity.Pages.Account.VerifyOtpModel
@{
    ViewData["Title"] = "Verify code";
}

<h1>@ViewData["Title"]</h1>
<div class="row">
    <div class="col-md-5">
        @if (!string.IsNullOrEmpty(Model.StatusMessage))
        {
            <div class="alert alert-info">@Model.StatusMessage</div>
        }
        <form method="post">
            <div asp-validation-summary="All" class="text-danger"></div>
            <div class="form-floating mb-3">
                <input asp-for="Input.Code" class="form-control" placeholder="123456" autocomplete="one-time-code" />
                <label asp-for="Input.Code"></label>
                <span asp-validation-for="Input.Code" class="text-danger"></span>
            </div>
            <button type="submit" class="btn btn-primary">Verify</button>
        </form>
        <form method="post" asp-page-handler="Resend" class="mt-2">
            <button type="submit" class="btn btn-link p-0">Resend code</button>
        </form>
    </div>
</div>
