@using MvC_SystemMovies.Models
@model List<Favorite>
@{
    ViewData["Title"] = "My favorites";
}

<div class="container my-4">
    <h1>My favorites</h1>

    @if (Model.Count == 0)
    {
        <p>You haven't favorited any movies yet. <a href="/Movies">Browse movies</a></p>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-3 g-3">
            @foreach (var fav in Model)
            {
                <div class="col">
                    <div class="card h-100">
                        <div class="card-body">
                            <h5 class="card-title">@fav.Movie?.Title</h5>
                            <p class="card-text">@fav.Movie?.Description</p>
                            <p class="text-muted">@fav.Movie?.Price.ToString("C")</p>
                            <a class="btn btn-sm btn-outline-dark" href="/Movies/@fav.MovieId">Details</a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
