@using MvC_SystemMovies.Models
@model List<Movie>
@{
    int currentPage = ViewBag.CurrentPage;
    int totalPages = ViewBag.TotalPages;

    string search = ViewBag.Search;
    string category = ViewBag.Category;
    string cinema = ViewBag.Cinema;
}
<style>
    body {
        margin: 0;
        background-color: #f5f5f5;
    }

    
    .cinema-navbar {
        background-color: #000;
        color: white;
        padding: 20px 40px;
        display: flex;
        justify-content: center;
        align-items: center;
        box-shadow: 0 3px 10px rgba(0, 0, 0, 0.3);
    }

        .cinema-navbar h2 {
            margin: 0;
            font-size: 28px;
            font-weight: bold;
            letter-spacing: 1px;
        }

    
    .cinema-page {
        min-height: calc(100vh - 150px);
        padding: 50px 30px;
    }

    .cinema-title {
        text-align: center;
        margin-bottom: 40px;
    }

        .cinema-title h1 {
            font-size: 40px;
            font-weight: bold;
            color: #111;
        }

        .cinema-title p {
            color: #777;
            font-size: 18px;
        }

    
    .cinema-cards {
        display: flex;
        justify-content: center;
        align-items: stretch;
        flex-wrap: wrap;
        gap: 25px;
        max-width: 1200px;
        margin: 0 auto;
    }

   
    .cinema-card {
        width: 280px;
        background: white;
        border-radius: 15px;
        overflow: hidden;
        box-shadow: 0 5px 20px rgba(0, 0, 0, 0.15);
        transition: all 0.3s ease;
    }

        .cinema-card:hover {
            transform: translateY(-10px);
            box-shadow: 0 12px 30px rgba(0, 0, 0, 0.25);
        }

        .cinema-card img {
            width: 100%;
            height: 190px;
            object-fit: cover;
            display: block;
        }

    .cinema-card-body {
        padding: 20px;
        text-align: center;
    }

        .cinema-card-body h3 {
            margin-bottom: 10px;
            font-size: 22px;
            font-weight: bold;
        }

        .cinema-card-body p {
            color: #777;
            margin-bottom: 20px;
        }

    .cinema-btn {
        display: inline-block;
        background-color: #000;
        color: white;
        text-decoration: none;
        padding: 10px 22px;
        border-radius: 8px;
        transition: 0.3s;
    }

        .cinema-btn:hover {
            background-color: #333;
            color: white;
            transform: scale(1.05);
        }


    .cinema-footer {
        background-color: #000;
        color: white;
        text-align: center;
        padding: 25px;
    }

        .cinema-footer p {
            margin: 0;
            color: #ccc;
        }

 
    @@media (max-width: 600px) {
        .cinema-navbar {
            padding: 18px;
        }

            .cinema-navbar h2 {
                font-size: 22px;
            }

        .cinema-page {
            padding: 35px 15px;
        }

        .cinema-title h1 {
            font-size: 30px;
        }

        .cinema-card {
            width: 100%;
            max-width: 330px;
        }
    }

    .movie-filters {
        max-width: 1100px;
        margin: 30px auto 40px;
        padding: 18px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 12px;
        background: white;
        border-radius: 14px;
        box-shadow: 0 5px 20px rgba(0,0,0,0.08);
    }

        .movie-filters input,
        .movie-filters select {
            height: 45px;
            border: 1px solid #ddd;
            border-radius: 8px;
            padding: 0 14px;
            font-size: 15px;
            outline: none;
        }

        .movie-filters input {
            width: 300px;
        }

            .movie-filters input:focus,
            .movie-filters select:focus {
                border-color: #111;
            }

        .movie-filters button {
            height: 45px;
            padding: 0 24px;
            border: none;
            border-radius: 8px;
            background: #000;
            color: white;
            font-weight: bold;
            cursor: pointer;
            transition: 0.3s;
        }

            .movie-filters button:hover {
                background: #e50914;
                transform: translateY(-2px);
            }

    .reset-btn {
        height: 45px;
        padding: 12px 20px;
        border-radius: 8px;
        background: #eee;
        color: #222;
        text-decoration: none;
        transition: 0.3s;
    }

        .reset-btn:hover {
            background: #ddd;
            color: #000;
        }

          (max-width: 768px) {

        .movie-filters {
            flex-direction: column;
            margin: 20px 15px 30px;
        }

            .movie-filters input,
            .movie-filters select,
            .movie-filters button,
            .reset-btn {
                width: 100%;
            }
    }
</style>
<nav class="cinema-navbar">
    <h2>Welcome to Cinema 🎬</h2>
</nav>


<form method="get" class="movie-filters">

    <div class="search-box">
        <input type="text"
               name="search"
               value="@search"
               placeholder="Search movies..." />
    </div>

    <select name="category">
        <option value="">All Categories</option>

        @foreach (var item in ViewBag.Categories)
        {
            <option value="@item.Name"
                    selected="@(category == item.Name ? "selected" : null)">
                @item.Name
            </option>
        }
    </select>

    <select name="cinema">
        <option value="">All Cinemas</option>

        @foreach (var item in ViewBag.Cinemas)
        {
            <option value="@item.Name"
                    selected="@(cinema == item.Name ? "selected" : null)">
                @item.Name
            </option>
        }
    </select>

    <button type="submit">
        🔍 Search
    </button>

    <a asp-area="Customer"
       asp-controller="Movie"
       asp-action="Index"
       class="reset-btn">
        Reset
    </a>

</form>
<main class="cinema-page">

    <div class="cinema-title">
        <h1>Our Cinemas</h1>
        <p>Choose your favorite cinema and enjoy your movie.</p>
    </div>

    <div class="cinema-cards">

        @foreach (var item in Model)
        {
            <div class="cinema-card">

                <img src="~/images/cinema/cinema3.jpg" class="card-img-top" alt="Movies img" >

                <div class="cinema-card-body">

                    <h3>@item.Title</h3>

                    <p>
                        <br> Description @item.Description,<br>
                        <br> Price  @item.Price,<br>
                        <br>Status: @item.Status<br>
                        <br>Release Date: @item.DateTime,<br>
                        <br>Category: @item.Category.Name,<br>
                        <br><Cinema>: @item.Cinema.Name,<br>
                       
                    </p>

                    <div class="d-flex gap-2 mt-2">
                        <a class="btn btn-sm btn-outline-dark" href="/Movies/@item.Id/@Uri.EscapeDataString(item.Title)">Details</a>

                        <form method="post" asp-area="Customer" asp-controller="Cart" asp-action="Add">
                            <input type="hidden" name="movieId" value="@item.Id" />
                            <button type="submit" class="btn btn-sm btn-primary">Add to cart</button>
                        </form>

                        <button type="button" class="btn btn-sm btn-outline-danger favorite-btn" data-movie-id="@item.Id">♥ Favorite</button>
                    </div>
                </div>

            </div>
        }
      
    </div>
    <div class="pagination">

        @if (currentPage > 1)
        {
            <a href="?page=@(currentPage - 1)
                &search=@search
                &category=@category
                &cinema=@cinema"
               class="btn btn-secondary">
                Previous
            </a>
        }

        @for (int i = 1; i <= totalPages; i++)
        {
            <a href="?page=@i
                &search=@search
                &category=@category
                &cinema=@cinema"
               class="btn @(i == currentPage ? "btn-primary" : "btn-light")">
                @i
            </a>
        }

        @if (currentPage < totalPages)
        {
            <a href="?page=@(currentPage + 1)
                &search=@search
                &category=@category
                &cinema=@cinema"
               class="btn btn-secondary">
                Next
            </a>
        }

    </div>

</main>

@section Scripts {
    <script>
        document.querySelectorAll('.favorite-btn').forEach(function (btn) {
            btn.addEventListener('click', async function () {
                const movieId = btn.dataset.movieId;
                const response = await fetch('/Customer/Favorite/Toggle', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ movieId: parseInt(movieId) })
                });

                if (response.status === 401) {
                    window.location.href = '/Identity/Account/Login';
                    return;
                }

                const data = await response.json();
                btn.classList.toggle('btn-outline-danger', !data.isFavorite);
                btn.classList.toggle('btn-danger', data.isFavorite);
                btn.textContent = data.isFavorite ? '♥ Favorited' : '♥ Favorite';
            });
        });
    </script>
}
    
                    
<footer class="cinema-footer">
    <p>© 2026 Cinema System — All Rights Reserved 🎬</p>
</footer>