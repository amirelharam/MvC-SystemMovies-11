@using Microsoft.AspNetCore.Identity
@using MvC_SystemMovies.Models
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<ul class="navbar-nav">
    @if (SignInManager.IsSignedIn(User))
    {
        <li class="nav-item">
            <a class="nav-link text-dark" asp-area="Customer" asp-controller="Cart" asp-action="Index">🛒 Cart</a>
        </li>
        <li class="nav-item">
            <a class="nav-link text-dark" asp-area="Customer" asp-controller="Favorite" asp-action="Index">♥ Favorites</a>
        </li>
        <li class="nav-item">
            <a class="nav-link text-dark" asp-area="Customer" asp-controller="Order" asp-action="Index">My orders</a>
        </li>
        <li class="nav-item">
            <span class="nav-link text-dark">Hello, @User.Identity!.Name!</span>
        </li>
        @if (User.IsInRole("Admin"))
        {
            <li class="nav-item">
                <a class="nav-link text-dark" href="/Admin/Dashbord/Index">Admin panel</a>
            </li>
        }
        <li class="nav-item">
            <form class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })" method="post">
                <button type="submit" class="nav-link btn btn-link text-dark">Log out</button>
            </form>
        </li>
    }
    else
    {
        <li class="nav-item">
            <a class="nav-link text-dark" asp-area="Identity" asp-page="/Account/Register">Register</a>
        </li>
        <li class="nav-item">
            <a class="nav-link text-dark" asp-area="Identity" asp-page="/Account/Login">Log in</a>
        </li>
    }
</ul>
